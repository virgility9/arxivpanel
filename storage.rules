rules_version = '2';

// Firebase Storage rules for Arxiv.
//
// Console: Storage → Rules tab → paste this file → Publish.
// Requires the Blaze (pay-as-you-go) plan — Storage cannot be enabled on
// the free Spark plan. See FIREBASE_SETUP.md for the steps.

// All file contents are public (avatars shown everywhere, PDFs readable
// by anyone with the link); writes are restricted as below.
service firebase.storage {
  match /b/{bucket}/o {

    // Profile avatars: anyone can read; a signed-in user may only write
    // their own avatar, and only image files under 10 MB.
    match /avatars/{userId}.{ext} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Paper PDFs: anyone can read; any signed-in user may upload
    // (the file becomes a paper's pdfUrl after the paper doc is created).
    match /paper-pdfs/{paperId}.pdf {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }
  }
}
